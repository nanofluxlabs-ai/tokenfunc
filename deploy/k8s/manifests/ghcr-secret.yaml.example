# GHCR 私有镜像拉取凭证（namespace 级）。复制为 ghcr-secret.yaml（git-ignored）后填值，或直接用命令创建：
#   kubectl -n tokenfunc create secret docker-registry ghcr-secret \
#     --docker-server=ghcr.io --docker-username=<github 用户> --docker-password=<read:packages 的 PAT>
apiVersion: v1
kind: Secret
metadata:
  name: ghcr-secret
  namespace: tokenfunc
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: '{"auths":{"ghcr.io":{"username":"<github-user>","password":"<pat-read-packages>"}}}'
