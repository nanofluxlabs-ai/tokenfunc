# 敏感配置模板。复制为 secret.yaml（git-ignored）后填值；或用 scripts/env-to-k8s.sh 从一份 .env 渲染。
# 改完 kubectl apply 后要 rollout restart 才生效。
apiVersion: v1
kind: Secret
metadata:
  name: tokenfunc-api
  namespace: tokenfunc
type: Opaque
stringData:
  # PaaS PostgreSQL；search_path 固定 public
  SQL_DSN: "postgresql://<user>:<password>@<host>:5432/tokenfunc?search_path=public&sslmode=require"
  REDIS_CONN_STRING: "redis://:<password>@<host>:6379/0"
  # 所有副本必须一致，否则登录态在副本间失效
  SESSION_SECRET: "<random-64-chars>"
  # 任务产物访问签名（可选，首次部署就定下来，之后不要换）
  CRYPTO_SECRET: "<random-64-chars>"
  # COS 子账号（只需 PutObject / HeadObject / GetObject）
  LOG_ARCHIVE_S3_ACCESS_KEY: "<secret-id>"
  LOG_ARCHIVE_S3_SECRET_KEY: "<secret-key>"
